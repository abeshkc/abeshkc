# Claude API — required only for smart intent parsing in the Voice tab
# Without this key, the app uses a simple rule-based parser as fallback
ANTHROPIC_API_KEY=your_anthropic_key_here

# Local Whisper settings — speech transcription runs on your machine
# Model sizes: tiny (fastest) | base (default) | small | medium (most accurate)
WHISPER_MODEL_SIZE=base

# Device: cpu (default, works everywhere) | cuda (requires NVIDIA GPU + CUDA)
WHISPER_DEVICE=cpu

# Compute type: int8 (default for CPU) | float16 (GPU) | float32
WHISPER_COMPUTE_TYPE=int8

# Language: leave blank for auto-detect, or set e.g. en, fr, ar
WHISPER_LANGUAGE=en

# Optional: custom path to cache downloaded Whisper models
# WHISPER_MODEL_PATH=C:/path/to/models

# Optional: set to 1 to keep temp audio files for debugging
# VOICE_DEBUG=0

# Optional: override SQLite path (used in tests)
# NOTEREMIND_DB=C:/path/to/data.db
