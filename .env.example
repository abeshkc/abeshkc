# ── Claude API (intent parsing — required for Voice tab) ──────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here


# ── Local Whisper (speech-to-text) ───────────────────────────────────────────
# Model sizes: tiny (fastest) | base (default) | small | medium (most accurate)
WHISPER_MODEL_SIZE=base

# Device: cpu (default) | cuda (NVIDIA GPU only)
WHISPER_DEVICE=cpu

# Compute type: int8 (default for CPU) | float16 (GPU)
WHISPER_COMPUTE_TYPE=int8

# Language: leave blank for auto-detect, or set e.g. en, ar, fr
WHISPER_LANGUAGE=en

# Optional: custom path to store downloaded Whisper models
# WHISPER_MODEL_PATH=C:/path/to/models


# ── Optional: local Qwen via Ollama (experimental alternative parser) ─────────
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_FALLBACK_MODEL=qwen2.5:3b
# OLLAMA_TIMEOUT=30


# ── App settings ──────────────────────────────────────────────────────────────
# Set to 1 to keep temp audio files for debugging
# VOICE_DEBUG=0

# Override SQLite path (used in tests)
# NOTEREMIND_DB=C:/path/to/data.db
